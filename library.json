{
  "name": "StateMachine",
  "version": "1.3.0",
  "description": "Compact C++ finite state machine for embedded systems. Table-driven, guard/entry/exit actions, typed event data, no dependencies.",
  "keywords": [
    "state machine",
    "fsm",
    "hsm",
    "embedded",
    "cpp",
    "event driven"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/endurodave/StateMachine.git"
  },
  "authors": [
    {
      "name": "David Lafreniere",
      "url": "https://github.com/endurodave",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/endurodave/StateMachine",
  "frameworks": "*",
  "platforms": "*",
  "headers": [
    "StateMachine.h",
    "Cpp_StateMachine.h"
  ],
  "export": {
    "include": [
      "src",
      "examples",
      "LICENSE",
      "README.md",
      "library.json",
      "library.properties"
    ],
    "exclude": [
      "**/.pio",
      "**/.pio/**"
    ]
  },
  "build": {
    "srcDir": "src",
    "includeDir": "src"
  },
  "examples": [
    {
      "name": "statemachine-demo",
      "base": "examples/platformio/statemachine-demo",
      "files": [
        "platformio.ini",
        "src/main.cpp",
        "src/Motor.cpp",
        "src/Motor.h"
      ]
    },
    {
      "name": "Cpp_StateMachine_Demo",
      "base": "examples/Cpp_StateMachine_Demo",
      "files": [
        "Cpp_StateMachine_Demo.ino",
        "Motor.cpp",
        "Motor.h"
      ]
    }
  ]
}
